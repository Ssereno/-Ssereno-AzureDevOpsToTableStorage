<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="General"     type="AzureDevOpsToPowerBI.Settings.GeneralSetting, devops-sync" />
    <section name="TeamProject" type="AzureDevOpsToPowerBI.Settings.TeamProjectSetting, devops-sync" />
    <section name="Logging"     type="AzureDevOpsToPowerBI.Settings.Logging.LoggingSetting, devops-sync" />
  </configSections>

  <General>
    <Connection TfsUri=""
                PersonalAccessToken=""
                WorkItemSyncDate="2025-01-01T00:00:00Z">
      <Storage Provider="SQLite"
               ConnectionString="Data Source=devops-sync.db" />
    </Connection>
    <FilterTag Tags="General" />
  </General>

  <TeamProject>
    <!--
      ProjectKey   : unique local identifier (used as ProjectKey in the database)
      ProjectName  : Azure DevOps project name (as it appears in the URL)
      AreaPath     : area path filter 
      TeamName     : team name for capacity/iteration queries
      IterationLevel: hierarchy level where the product name lives
      TfsUri       : (optional) overrides the global TfsUri for this project
      PersonalAccessToken: (optional) overrides the global PAT for this project
    -->
    <Project ProjectKey=""
             ProjectName=""
             AreaPath=""
             TeamName=""
             IterationLevel="0" />
  </TeamProject>

  <Logging>
    <Log MinimumLevel="Information"
         LogPath="logs\devops-sync.log"
         RollingInterval="Day"
         RetainedFiles="7"
         EnableConsole="true" />
  </Logging>
</configuration>
